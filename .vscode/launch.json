{
    "version": "0.2.0",
    "configurations": [
        {
            // --no-reload is load-bearing, do not remove it. This config runs
            // `flask run` against the app:create_initialized_app factory, which
            // bypasses app.py's main() and therefore its reloader rule. Importing
            // app no longer runs startup, but the factory initializes the runtime
            // database (migration, seed bootstrap, schema, catalog upgrade,
            // startup snapshot) in every process that loads it, so with the
            // reloader on, the monitoring parent and the serving child would both
            // initialize against one database. Every flask subcommand against
            // this factory (run, routes, shell, ...) initializes the runtime
            // database too.
            //
            // FLASK_DEBUG=1 is kept on purpose: it enables the debugger, and
            // utils/database.py reads it to select DELETE journal mode instead of
            // WAL, which is the safer mode during development. FLASK_ENV was
            // removed -- Flask has ignored it since 2.3, and the one place that
            // still reads it (utils/database.py) already gets the same answer
            // from FLASK_DEBUG.
            "name": "Flask (Hypertrophy Toolbox)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app:create_initialized_app",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-reload",
                "--host",
                "localhost",
                "--port",
                "5000"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Run app.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}